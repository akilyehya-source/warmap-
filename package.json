{
  "name": "frontlines",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:prepare": "node scripts/data/prepare.ts",
    "data:validate": "node scripts/data/validate.ts",
    "data:roads": "node scripts/data/roads.ts",
    "data:world": "node scripts/data/world.ts",
    "data:world:validate": "node scripts/data/world.ts --validate",
    "data:campaign": "node scripts/data/campaign.mjs",
    "data:campaign:validate": "node scripts/data/campaign.mjs --validate",
    "test:stress": "tsx scripts/stress.ts",
    "lint": "oxlint",
    "preview": "vite preview"
